<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET client under test (docs/driver-contract.md). KurrentDB.Client is pinned to an exact version; `version`
       reports it from KurrentDBClientVersion, the same property the PackageReference uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LiveDriver.DotNet</AssemblyName>
    <RootNamespace>LiveDriver</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <KurrentDBClientVersion>1.6.0</KurrentDBClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KurrentDB.Client" Version="[$(KurrentDBClientVersion)]" />
    <PackageReference Include="HdrHistogram" Version="[2.5.0]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KurrentDBClientVersion" Value="$(KurrentDBClientVersion)" />
  </ItemGroup>

</Project>
