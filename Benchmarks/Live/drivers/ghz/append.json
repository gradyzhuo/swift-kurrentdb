{
  "proto": "kurrentdb/v1/streams.proto",
  "import-paths": ["../../../../proto"],
  "call": "event_store.client.streams.Streams.Append",
  "connections": 1,
  "load-schedule": "const",
  "duration-stop": "wait",
  "format": "json",
  "data": [
    {
      "options": {
        "stream_identifier": { "stream_name": "{{b64enc (printf `@@STREAM_PREFIX@@-%d` (mod .RequestNumber @@STREAM_COUNT@@))}}" },
        "any": {}
      }
    },
    {
      "proposed_message": {
        "id": { "string": "{{newUUID}}" },
        "metadata": { "type": "BenchEvent", "content-type": "application/json" },
        "custom_metadata": "@@METADATA@@",
        "data": "@@DATA@@"
      }
    }
  ]
}
