KURRENTDB_CLUSTER_SIZE=3
KURRENTDB_RUN_PROJECTIONS=All
KURRENTDB_START_STANDARD_PROJECTIONS=true
KURRENTDB_DISCOVER_VIA_DNS=false
KURRENTDB_ENABLE_ATOM_PUB_OVER_HTTP=true
KURRENTDB_ADVERTISE_HOST_TO_CLIENT_AS=127.0.0.1
# A node is declared dead when gossip to it times out; the default 2500 ms is too tight for a
# shared CI runner, where a CPU stall under load has made the followers elect a new leader in
# the middle of a test. Tolerate stalls of up to 10 s before starting an election.
KURRENTDB_GOSSIP_TIMEOUT_MS=10000
